# Copy this file to .env and fill in your values.

PORT=3000

# Your WhatsApp Business number in international format, digits only (no +, spaces or dashes).
# Example for Pakistan: 923001234567
WHATSAPP_NUMBER=923001234567

# Showcase mode (false) = products + "Order on WhatsApp".
# Store mode (true)     = cart, checkout and the /api/orders endpoint are switched on.
STORE_ENABLED=false

# Show prices on product cards/pages
SHOW_PRICES=false
CURRENCY=PKR

# Brand theme used by the website: blush | herbal
DEFAULT_THEME=blush

# Comma-separated list of allowed frontend origins (only needed if frontend is hosted elsewhere)
CORS_ORIGINS=http://localhost:4200

INSTAGRAM_URL=
FACEBOOK_URL=
CONTACT_EMAIL=
